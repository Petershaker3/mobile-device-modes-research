{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/operation.schema.json",
  "title": "Operation",
  "description": "The long-lived record of one unit of work. Created before anything touches a device, mutated only through the Operation Engine, and always traceable to a Plan and an Audit trail.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operationId", "operationType", "targetDeviceId", "impactLevel", "state", "createdAt", "updatedAt", "progress", "warnings"],
  "properties": {
    "operationId": { "$ref": "_common.schema.json#/$defs/uuid" },
    "operationType": {
      "type": "string",
      "enum": [
        "device.discover",
        "device.read_info",
        "device.mode_transition",
        "app.list",
        "app.details",
        "app.install",
        "app.uninstall",
        "app.disable",
        "app.enable",
        "app.export_apk",
        "file.list",
        "file.pull",
        "file.push",
        "file.delete",
        "file.rename",
        "diagnostics.logcat_capture",
        "diagnostics.bugreport",
        "diagnostics.dumpsys",
        "storage.read_usage",
        "firmware.inspect_package",
        "firmware.inspect_image",
        "backup.create",
        "backup.restore",
        "network.dns_read",
        "network.dns_apply",
        "drivers.diagnose",
        "package.download",
        "package.inspect"
      ],
      "description": "Closed set. A new feature means a new enum value plus a plan/result contract, not a free-form string."
    },
    "targetDeviceId": {
      "oneOf": [
        { "$ref": "_common.schema.json#/$defs/deviceId" },
        { "type": "null" }
      ],
      "description": "Null only for local-only operations (package.inspect, firmware.inspect_package). No device-touching operation may have a null target."
    },
    "impactLevel": { "$ref": "_common.schema.json#/$defs/impactLevel" },
    "state": { "$ref": "_common.schema.json#/$defs/operationState" },
    "createdAt": { "$ref": "_common.schema.json#/$defs/isoTimestamp" },
    "updatedAt": { "$ref": "_common.schema.json#/$defs/isoTimestamp" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "endedAt": { "type": ["string", "null"], "format": "date-time" },
    "deadline": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Absolute deadline derived from the limits table in docs/18. Past the deadline the operation becomes OutcomeUnknown, never silently Failed."
    },
    "cancellationRequested": { "type": "boolean", "default": false },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "Discovering",
            "Planning",
            "Validating",
            "Previewing",
            "AwaitingApproval",
            "Transferring",
            "Installing",
            "Reading",
            "Extracting",
            "Verifying",
            "Reconciling",
            "CleaningUp",
            "Done"
          ]
        },
        "current": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "unit": { "type": ["string", "null"], "enum": ["Bytes", "Files", "Packages", "Steps", "Percent", null] },
        "message": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "planId": {
      "oneOf": [{ "$ref": "_common.schema.json#/$defs/uuid" }, { "type": "null" }],
      "description": "The Plan this operation executes. An operation that writes must reference an approved plan."
    },
    "approvalTokenId": {
      "oneOf": [{ "$ref": "_common.schema.json#/$defs/uuid" }, { "type": "null" }],
      "description": "The token that authorized execution. Null for ReadOnly operations. Never inferred from the presence of a plan."
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "_common.schema.json#/$defs/warning" }
    },
    "result": {
      "oneOf": [{ "$ref": "result.schema.json" }, { "type": "null" }],
      "description": "Populated on the first terminal or non-terminal-unresolved transition."
    },
    "auditEventIds": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "_common.schema.json#/$defs/uuid" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "_common.schema.json#/$defs/artifact" }
    },
    "parentOperationId": {
      "oneOf": [{ "$ref": "_common.schema.json#/$defs/uuid" }, { "type": "null" }],
      "description": "Set for batch children. Each child carries its own Result; a batch is Partial when children disagree, never Succeeded by majority."
    },
    "retryOfOperationId": {
      "oneOf": [{ "$ref": "_common.schema.json#/$defs/uuid" }, { "type": "null" }],
      "description": "Set when a human re-runs an earlier operation. Automatic retry is forbidden for RetryAfterReconcile outcomes."
    }
  },
  "allOf": [
    {
      "description": "Any operation that can change device or system state must carry a plan and an approval token before it may run.",
      "if": {
        "properties": { "impactLevel": { "enum": ["DeviceWrite", "WindowsSystemChange", "Destructive"] } },
        "required": ["impactLevel"]
      },
      "then": {
        "required": ["planId", "approvalTokenId"],
        "properties": {
          "planId": { "$ref": "_common.schema.json#/$defs/uuid" },
          "approvalTokenId": { "$ref": "_common.schema.json#/$defs/uuid" }
        }
      }
    },
    {
      "description": "Device-touching operation types must name a device.",
      "if": {
        "properties": {
          "operationType": { "not": { "enum": ["package.inspect", "firmware.inspect_package", "firmware.inspect_image"] } }
        },
        "required": ["operationType"]
      },
      "then": { "required": ["targetDeviceId"], "properties": { "targetDeviceId": { "$ref": "_common.schema.json#/$defs/deviceId" } } }
    },
    {
      "description": "Terminal states must have an endedAt and a result.",
      "if": {
        "properties": { "state": { "enum": ["Succeeded", "Partial", "Failed", "Cancelled"] } },
        "required": ["state"]
      },
      "then": {
        "required": ["endedAt", "result"],
        "properties": {
          "endedAt": { "type": "string", "format": "date-time" },
          "result": { "$ref": "result.schema.json" }
        }
      }
    }
  ]
}
