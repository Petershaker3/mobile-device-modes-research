<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/DeviceToolkit.Wpd/DeviceToolkit.Wpd.csproj" />
    <ProjectReference Include="../../../src/DeviceToolkit.Wpd.Worker/DeviceToolkit.Wpd.Worker.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="MediaDevices" Version="2.0.0" />
  </ItemGroup>
  <Target Name="CopyWpdWorkerToSmokeOutput" AfterTargets="Build">
    <ItemGroup>
      <WpdWorkerFile Include="../../../src/DeviceToolkit.Wpd.Worker/bin/$(Configuration)/net10.0-windows/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WpdWorkerFile)" DestinationFiles="@(WpdWorkerFile->'$(OutDir)WpdWorker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
