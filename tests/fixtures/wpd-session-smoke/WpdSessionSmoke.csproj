<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeviceToolkit.Wpd.SessionSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/DeviceToolkit.Wpd/DeviceToolkit.Wpd.csproj" />
    <ProjectReference Include="../wpd-session-fake-worker/WpdSessionFakeWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFakeWorkerToSmokeOutput" AfterTargets="Build">
    <ItemGroup>
      <FakeWorkerFile Include="../wpd-session-fake-worker/bin/$(Configuration)/net10.0-windows/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeWorkerFile)" DestinationFiles="@(FakeWorkerFile->'$(OutDir)FakeWorker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
